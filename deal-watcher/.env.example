# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Your chat id (talk to @userinfobot, or run: npm run ping)
TELEGRAM_CHAT_ID=123456789
# Optional: extra chat ids allowed to send commands, comma separated
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional: path to config (default ./config.json)
DEAL_WATCHER_CONFIG=./config.json
